+* {
+  box-sizing: border-box;
+}
+
+body {
+  margin: 0;
+  font-family: 'Inter', system-ui, -apple-system, sans-serif;
+  background: var(--color-bg);
+  color: var(--color-text);
+}
+
+.app-shell {
+  max-width: var(--max-width);
+  margin: 0 auto;
+  padding: 32px 16px 64px;
+}
+
+.app-header h1 {
+  margin: 0;
+  font-size: 2rem;
+}
+
+.app-header .lede {
+  margin: 4px 0 16px;
+  color: var(--color-muted);
+}
+
+.status {
+  padding: 16px;
+  text-align: center;
+  color: var(--color-text);
+}
+
+.status.error {
+  color: #f87171;
+}
+
+.list {
+  display: flex;
+  flex-direction: column;
+  gap: var(--gap);
+}
+
+.category {
+  background: var(--color-surface);
+  border-radius: var(--radius);
+  padding: 16px;
+  border: 1px solid rgba(255, 255, 255, 0.05);
+}
+
+.category-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  margin-bottom: 12px;
+}
+
+.category-title {
+  font-weight: 600;
+}
+
+.records {
+  list-style: none;
+  padding: 0;
+  margin: 0;
+  display: flex;
+  flex-direction: column;
+  gap: 10px;
+}
+
+.record {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 10px 12px;
+  border-radius: var(--radius);
+  background: rgba(255, 255, 255, 0.02);
+}
+
+.record-main {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  min-width: 0;
+}
+
+.record-title {
+  font-weight: 600;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.record-date {
+  color: var(--color-muted);
+  font-size: 0.9rem;
+}
+
+.badge {
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  border-radius: 999px;
+  padding: 6px 10px;
+  font-size: 0.85rem;
+  background: var(--color-badge);
+  color: #0f172a;
+  font-weight: 600;
+  white-space: nowrap;
+}
+
+.badge-single {
+  background: var(--color-badge);
+}
+
+.badge-multiple {
+  background: var(--color-accent);
+  color: #0b1020;
+}
+
+@media (max-width: 480px) {
+  .app-shell {
+    padding: 20px 12px 48px;
+  }
+  .category-header {
+    flex-direction: column;
+    align-items: flex-start;
+  }
+  .records {
+    gap: 8px;
+  }
+  .record {
+    align-items: flex-start;
+    flex-direction: column;
+  }
+  .record-main {
+    width: 100%;
+  }
+}
