{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Noise Evidence Data",
  "type": "object",
  "properties": {
    "categories": {
      "type": "array",
      "items": { "$ref": "#/definitions/category" }
    }
  },
  "required": ["categories"],
  "definitions": {
    "category": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "records": {
          "type": "array",
          "items": { "$ref": "#/definitions/record" }
        }
      },
      "required": ["id", "title", "records"]
    },
    "record": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "categoryId": { "type": "string" },
        "title": { "type": "string" },
        "occurredAt": { "type": "string", "format": "date-time" },
        "media": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/mediaItem" }
        }
      },
      "required": ["id", "categoryId", "title", "occurredAt", "media"]
    },
    "mediaItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["image", "video"] },
        "title": { "type": "string" },
        "source": { "type": "string" },
        "durationSeconds": { "type": ["number", "null"], "minimum": 0 },
        "originalFilename": { "type": "string" }
      },
      "required": ["id", "type", "title", "source", "originalFilename"]
    }
  }
}
